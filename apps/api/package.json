{
  "name": "@eduhousing/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build:shared": "npm run build -w @eduhousing/shared",
    "predev": "npm run build:shared",
    "dev": "nest start --watch",
    "prebuild": "npm run build:shared",
    "build": "nest build",
    "start": "node dist/main.js",
    "pretest": "npm run build:shared",
    "test": "jest --runInBand",
    "migrate": "node-pg-migrate up --migrations-dir src/migrations --envPath ../../.env",
    "migrate:down": "node-pg-migrate down --migrations-dir src/migrations --envPath ../../.env",
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@eduhousing/shared": "*",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/platform-express": "^11.2.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^16.5.0",
    "node-pg-migrate": "^7.9.1",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.7",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.15.4",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
